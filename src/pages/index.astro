---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Experience from '../components/Experience.astro';
import Skills from '../components/Skills.astro';
import Projects from '../components/Projects.astro';
import Certifications from '../components/Certifications.astro';
---

<Layout title="Naresh V - AI Engineer Portfolio">
  <Navbar />
  <Hero />
  
  <!-- Experience Section -->
  <Experience />

  <Skills />

  <Projects />

  <Certifications />

  <section id="achievements" class="min-h-screen py-20 px-6 bg-dark">
    <div class="container mx-auto">
      <h2 class="text-4xl font-bold text-center mb-12">Achievements</h2>
    </div>
  </section>

  <section id="contact" class="min-h-screen py-20 px-6 bg-dark-purple">
    <div class="container mx-auto">
      <h2 class="text-4xl font-bold text-center mb-12">Contact</h2>
    </div>
  </section>
</Layout>
