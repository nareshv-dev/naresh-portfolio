---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
---

<Layout title="Naresh V - AI Engineer Portfolio">
  <Navbar />
  <Hero />
  
  <!-- About Section - We'll build this next -->
  <section id="about" class="min-h-screen py-20 px-6 bg-dark">
    <div class="container mx-auto">
      <h2 class="text-4xl font-bold text-center mb-12 text-white">About Me</h2>
      <p class="text-center text-gray-400">Coming soon...</p>
    </div>
  </section>

  <!-- Other sections placeholders -->
  <section id="experience" class="min-h-screen py-20 px-6 bg-dark-purple">
    <div class="container mx-auto">
      <h2 class="text-4xl font-bold text-center mb-12">Experience</h2>
    </div>
  </section>

  <section id="skills" class="min-h-screen py-20 px-6 bg-dark">
    <div class="container mx-auto">
      <h2 class="text-4xl font-bold text-center mb-12">Skills</h2>
    </div>
  </section>

  <section id="projects" class="min-h-screen py-20 px-6 bg-dark-purple">
    <div class="container mx-auto">
      <h2 class="text-4xl font-bold text-center mb-12">Projects</h2>
    </div>
  </section>

  <section id="achievements" class="min-h-screen py-20 px-6 bg-dark">
    <div class="container mx-auto">
      <h2 class="text-4xl font-bold text-center mb-12">Achievements</h2>
    </div>
  </section>

  <section id="contact" class="min-h-screen py-20 px-6 bg-dark-purple">
    <div class="container mx-auto">
      <h2 class="text-4xl font-bold text-center mb-12">Contact</h2>
    </div>
  </section>
</Layout>
