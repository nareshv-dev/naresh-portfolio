---
---

<section id="home" class="min-h-screen flex items-center pt-24 pb-16 bg-gradient-to-br from-sea-dark via-dark-purple to-primary">
  <div class="container mx-auto px-6">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      
      <!-- Left Content -->
      <div class="animate-fade-in space-y-6">
        <!-- Tag -->
        <div class="inline-block px-6 py-2 rounded-full border border-secondary/60 backdrop-blur-sm bg-primary/20">
          <span class="text-sm tracking-wider text-secondary font-medium">AI RESEARCH • MACHINE LEARNING DEVELOPER</span>
        </div>
        
        <!-- Name -->
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold leading-tight">
          Naresh Venkadesh
        </h1>
        
        <!-- Role -->
        <p class="text-2xl md:text-3xl font-medium bg-gradient-to-r from-primary via-secondary to-accent bg-clip-text text-transparent">
          Machine Learning Developer • AI Enthusiast
        </p>
        
        <!-- Bio -->
        <div class="space-y-4 text-gray-300">
          <p class="text-lg leading-relaxed">
            I build AI systems that blend research depth with production rigor—pushing beyond LLMs to create intelligent solutions that learn, adapt, and deliver real-world impact.
          </p>
          <p class="text-lg leading-relaxed">
            Passionate about turning complex data into actionable insights and building ML models that solve meaningful problems.
          </p>
        </div>
        
        <!-- CTA Buttons -->
        <div class="flex flex-wrap gap-4 pt-4">
          <a href="#projects" class="group px-6 py-3 bg-primary border-2 border-primary rounded-lg font-semibold transition-all hover:bg-sea-medium text-white hover:shadow-lg hover:shadow-primary/40">
            <i class="fas fa-briefcase mr-2"></i>
            View Projects
          </a>
          <a href="#contact" class="px-6 py-3 border-2 border-secondary rounded-lg text-secondary font-semibold hover:bg-secondary hover:text-dark transition-all">
            <i class="fas fa-envelope mr-2"></i>
            Contact Me
          </a>
          <a href="/Naresh V Resume.pdf" download class="px-6 py-3 bg-accent rounded-lg text-dark font-bold hover:shadow-lg hover:shadow-accent/50 transition-all transform hover:-translate-y-1">
            <i class="fas fa-download mr-2"></i>
            Resume
          </a>
        </div>
        
        <!-- Social Links -->
        <div class="flex gap-4 pt-4">
          <a href="https://linkedin.com" target="_blank" class="w-12 h-12 rounded-full bg-primary hover:bg-secondary flex items-center justify-center transition-all hover:scale-110 border border-secondary/30 shadow-lg shadow-primary/20">
            <i class="fab fa-linkedin-in text-xl text-white"></i>
          </a>
          <a href="https://github.com" target="_blank" class="w-12 h-12 rounded-full bg-primary hover:bg-secondary flex items-center justify-center transition-all hover:scale-110 border border-secondary/30 shadow-lg shadow-primary/20">
            <i class="fab fa-github text-xl text-white"></i>
          </a>
          <a href="https://kaggle.com" target="_blank" class="w-12 h-12 rounded-full bg-primary hover:bg-secondary flex items-center justify-center transition-all hover:scale-110 border border-secondary/30 shadow-lg shadow-primary/20">
            <i class="fab fa-kaggle text-xl text-white"></i>
          </a>
        </div>
      </div>
      
      <!-- Right Content - Photo & Stats -->
      <div class="animate-fade-in-delay space-y-6">
        <!-- Photo -->
        <div class="relative mx-auto max-w-md">
          <div class="aspect-square rounded-3xl overflow-hidden border-4 border-secondary/50 shadow-2xl shadow-primary/40 bg-gradient-to-br from-primary/20 to-secondary/20">
            <!-- Placeholder for photo - replace with your image -->
            <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-primary/30 to-secondary/40">
              <i class="fas fa-user text-9xl text-accent/70"></i>
            </div>
          </div>
          <!-- Glow effect -->
          <div class="absolute inset-0 rounded-3xl bg-gradient-to-br from-secondary/30 to-primary/30 blur-3xl -z-10"></div>
        </div>
        
        <!-- Stats Cards -->
        <div class="grid grid-cols-2 gap-4">
          <div class="stat-card p-6 rounded-2xl border border-secondary/40 bg-dark-purple/60 backdrop-blur-sm hover:border-secondary hover:bg-primary/40 transition-all">
            <p class="text-xs uppercase tracking-wider text-accent/80 mb-2">Projects</p>
            <p class="text-3xl font-bold text-secondary">15+</p>
          </div>
          
          <div class="stat-card p-6 rounded-2xl border border-secondary/40 bg-dark-purple/60 backdrop-blur-sm hover:border-secondary hover:bg-primary/40 transition-all">
            <p class="text-xs uppercase tracking-wider text-accent/80 mb-2">Experience</p>
            <p class="text-3xl font-bold text-secondary">2+ Years</p>
          </div>
          
          <div class="stat-card p-6 rounded-2xl border border-secondary/40 bg-dark-purple/60 backdrop-blur-sm hover:border-secondary hover:bg-primary/40 transition-all">
            <p class="text-xs uppercase tracking-wider text-accent/80 mb-2">Kaggle</p>
            <p class="text-3xl font-bold text-secondary">Expert</p>
          </div>
          
          <div class="stat-card p-6 rounded-2xl border border-secondary/40 bg-dark-purple/60 backdrop-blur-sm hover:border-secondary hover:bg-primary/40 transition-all">
            <p class="text-xs uppercase tracking-wider text-accent/80 mb-2">Awards</p>
            <p class="text-3xl font-bold text-secondary">5+</p>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</section>

<style>
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fade-in-delay {
    from {
      opacity: 0;
      transform: translateX(20px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .animate-fade-in {
    animation: fade-in 1s ease-out;
  }
  
  .animate-fade-in-delay {
    animation: fade-in-delay 1s ease-out 0.3s both;
  }
  
  .stat-card {
    transition: all 0.3s ease;
  }
  
  .stat-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(83, 210, 220, 0.4);
  }
</style>
