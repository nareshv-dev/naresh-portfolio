---

<section id="home" class="min-h-screen flex items-center pt-24 pb-16 bg-navy">
  <div class="container mx-auto px-6">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      
      <!-- Left Content -->
      <div class="animate-fade-in space-y-6">
        
        <!-- Tag -->
        <div class="inline-block px-6 py-2 rounded-full border border-white/30 backdrop-blur-sm bg-white/5">
          <span class="text-sm tracking-wider text-white font-medium">MACHINE LEARNING ENGINEER • AI SOLUTIONS BUILDER</span>
        </div>
        
        <!-- Name -->
        <h1 class="text-4xl md:text-5xl font-bold leading-tight text-white">
          Naresh Venkadesh
        </h1>
        
        <!-- Bio -->
        <div class="space-y-4 text-white/70">
          <p class="text-lg leading-relaxed">
            I am a passionate Machine Learning Engineer focused on building intelligent, real-world solutions using data, AI, and scalable systems. I specialize in developing end-to-end ML projects — from data preprocessing and model training to deployment and user-friendly applications.
          </p>
          <p class="text-lg leading-relaxed">
            I enjoy experimenting with new technologies, collaborating on innovative ideas, and continuously learning to stay at the forefront of AI advancements.
          </p>
        </div>
        
        <!-- Education Card -->
        <div class="flex items-start gap-4 px-5 py-4 rounded-xl border border-white/15 bg-white/5 backdrop-blur-sm max-w-md">
          <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-white/10 flex items-center justify-center mt-0.5">
            <i class="fas fa-graduation-cap text-lg text-accent"></i>
          </div>
          <div>
            <h3 class="text-white font-semibold text-base">KPR Institute of Engineering and Technology</h3>
            <p class="text-white/60 text-sm">B.E. Computer Science and Engineering</p>
            <p class="text-white/40 text-xs mt-1">
              <i class="fas fa-map-marker-alt mr-1"></i>Coimbatore, Tamil Nadu
              <span class="mx-2">•</span>
              <i class="fas fa-calendar-alt mr-1"></i>2023 – Present
            </p>
          </div>
        </div>
        
        <!-- CTA Buttons -->
        <div class="flex flex-wrap gap-4 pt-4">
          <a href="#projects" class="group px-6 py-3 bg-white text-navy rounded-lg font-semibold transition-all hover:bg-white/90 hover:shadow-lg hover:shadow-white/20">
            <i class="fas fa-briefcase mr-2"></i>
            View Projects
          </a>
          <a href="#contact" class="px-6 py-3 border-2 border-white rounded-lg text-white font-semibold hover:bg-white hover:text-navy transition-all">
            <i class="fas fa-envelope mr-2"></i>
            Contact Me
          </a>
          <a href="/Naresh_V_Resume.pdf" download class="px-6 py-3 bg-white text-navy rounded-lg font-bold hover:shadow-lg hover:shadow-white/20 transition-all transform hover:-translate-y-1">
            <i class="fas fa-download mr-2"></i>
            Resume
          </a>
        </div>
        
        <!-- Social Links -->
        <div class="flex gap-4 pt-4">
          <a href="https://www.linkedin.com/in/naresh-v/" target="_blank" class="w-12 h-12 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center transition-all hover:scale-110 border border-white/20">
            <i class="fab fa-linkedin-in text-xl text-white"></i>
          </a>
          <a href="https://github.com/nareshv-dev" target="_blank" class="w-12 h-12 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center transition-all hover:scale-110 border border-white/20">
            <i class="fab fa-github text-xl text-white"></i>
          </a>
          <a href="https://leetcode.com/u/Naresh_V/" target="_blank" class="w-12 h-12 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center transition-all hover:scale-110 border border-white/20">
            <i class="fas fa-code text-xl text-white"></i>
          </a>
        </div>
      </div>
      
      <!-- Right Content - Photo with Floating ML/DL Logos -->
      <div class="animate-fade-in-delay flex justify-center">
        <div class="relative floating-logos-container">
          
          <!-- Outer Orbit Ring (visual) -->
          <div class="absolute inset-[-60px] md:inset-[-70px] rounded-full border border-white/10 orbit-ring"></div>
          <div class="absolute inset-[-110px] md:inset-[-130px] rounded-full border border-white/5 orbit-ring-2"></div>

          <!-- Floating ML/DL Tool Logos - Outer Orbit -->
          <div class="floating-logo logo-orbit-2" style="--orbit-radius: 210px; --orbit-start: 0deg; --orbit-speed: 35s;" title="Python">
            <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/python/python-original.svg" alt="Python" width="32" height="32" />
          </div>
          <div class="floating-logo logo-orbit-2" style="--orbit-radius: 210px; --orbit-start: 45deg; --orbit-speed: 35s;" title="Kaggle">
            <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/kaggle/kaggle-original.svg" alt="Kaggle" width="32" height="32" />
          </div>
          <div class="floating-logo logo-orbit-2" style="--orbit-radius: 210px; --orbit-start: 90deg; --orbit-speed: 35s;" title="Matplotlib">
            <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/matplotlib/matplotlib-original.svg" alt="Matplotlib" width="32" height="32" />
          </div>
          <div class="floating-logo logo-orbit-2" style="--orbit-radius: 210px; --orbit-start: 135deg; --orbit-speed: 35s;" title="VS Code">
            <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/vscode/vscode-original.svg" alt="VS Code" width="32" height="32" />
          </div>
          <div class="floating-logo logo-orbit-2" style="--orbit-radius: 210px; --orbit-start: 180deg; --orbit-speed: 35s;" title="Anaconda">
            <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/anaconda/anaconda-original.svg" alt="Anaconda" width="32" height="32" />
          </div>
          <div class="floating-logo logo-orbit-2" style="--orbit-radius: 210px; --orbit-start: 225deg; --orbit-speed: 35s;" title="HuggingFace">
            <svg viewBox="0 0 120 120" width="32" height="32" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="60" cy="60" r="56" fill="#FFD21E"/>
              <path d="M38 70c0-6 4-10 10-10s10 4 10 10" stroke="#1A1A2E" stroke-width="4" stroke-linecap="round"/>
              <path d="M62 70c0-6 4-10 10-10s10 4 10 10" stroke="#1A1A2E" stroke-width="4" stroke-linecap="round"/>
              <circle cx="42" cy="50" r="5" fill="#1A1A2E"/>
              <circle cx="78" cy="50" r="5" fill="#1A1A2E"/>
              <path d="M45 82c4 6 26 6 30 0" stroke="#1A1A2E" stroke-width="4" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="floating-logo logo-orbit-2" style="--orbit-radius: 210px; --orbit-start: 270deg; --orbit-speed: 35s;" title="MySQL">
            <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/mysql/mysql-original.svg" alt="MySQL" width="32" height="32" />
          </div>
          <div class="floating-logo logo-orbit-2" style="--orbit-radius: 210px; --orbit-start: 315deg; --orbit-speed: 35s;" title="Streamlit">
            <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/streamlit/streamlit-original.svg" alt="Streamlit" width="32" height="32" />
          </div>

          <!-- Circular Photo -->
          <div class="relative z-10">
            <div class="w-64 h-64 md:w-72 md:h-72 rounded-full overflow-hidden border-4 border-white/30 shadow-2xl photo-glow">
              <img src="/profile.jpg" alt="Naresh Venkadesh" class="w-full h-full object-cover" />
            </div>
          </div>

          <!-- Glow effect -->
          <div class="absolute inset-0 rounded-full bg-gradient-to-br from-blue-500/20 to-purple-500/20 blur-3xl -z-10 animate-pulse-slow"></div>
        </div>
      </div>
      
    </div>
  </div>
</section>

<style>
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fade-in-delay {
    from {
      opacity: 0;
      transform: translateX(20px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes shine {
    0% {
      background-position: -200% center;
    }
    100% {
      background-position: 200% center;
    }
  }

  /* Orbital floating animation */
  @keyframes orbit {
    from {
      transform: rotate(var(--orbit-start)) translateX(var(--orbit-radius)) rotate(calc(-1 * var(--orbit-start)));
    }
    to {
      transform: rotate(calc(var(--orbit-start) + 360deg)) translateX(var(--orbit-radius)) rotate(calc(-1 * (var(--orbit-start) + 360deg)));
    }
  }

  @keyframes orbit-reverse {
    from {
      transform: rotate(var(--orbit-start)) translateX(var(--orbit-radius)) rotate(calc(-1 * var(--orbit-start)));
    }
    to {
      transform: rotate(calc(var(--orbit-start) - 360deg)) translateX(var(--orbit-radius)) rotate(calc(-1 * (var(--orbit-start) - 360deg)));
    }
  }

  @keyframes pulse-slow {
    0%, 100% { opacity: 0.4; transform: scale(1); }
    50% { opacity: 0.7; transform: scale(1.05); }
  }

  @keyframes ring-rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes ring-rotate-reverse {
    from { transform: rotate(0deg); }
    to { transform: rotate(-360deg); }
  }

  .animate-fade-in {
    animation: fade-in 1s ease-out;
  }
  
  .animate-fade-in-delay {
    animation: fade-in-delay 1s ease-out 0.3s both;
  }
  
  .shiny-text {
    background: linear-gradient(
      90deg,
      #ffffff 0%,
      #ffffff 40%,
      #60a5fa 50%,
      #ffffff 60%,
      #ffffff 100%
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shine 3s linear infinite;
  }

  .animate-pulse-slow {
    animation: pulse-slow 4s ease-in-out infinite;
  }

  /* Floating logos container */
  .floating-logos-container {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    width: 18rem;
    height: 18rem;
  }

  @media (min-width: 768px) {
    .floating-logos-container {
      width: 20rem;
      height: 20rem;
    }
  }

  /* Each floating logo */
  .floating-logo {
    position: absolute;
    top: 50%;
    left: 50%;
    margin-top: -22px;
    margin-left: -22px;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 12px;
    backdrop-filter: blur(8px);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3), 0 0 20px rgba(96, 165, 250, 0.1);
    z-index: 5;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .floating-logo:hover {
    box-shadow: 0 4px 20px rgba(96, 165, 250, 0.4), 0 0 30px rgba(96, 165, 250, 0.2);
    z-index: 20;
    transform: scale(1.3) !important;
  }

  .logo-orbit-1 {
    animation: orbit var(--orbit-speed) linear infinite;
  }

  .logo-orbit-2 {
    animation: orbit-reverse var(--orbit-speed) linear infinite;
  }

  /* Orbit ring animations */
  .orbit-ring {
    animation: ring-rotate 25s linear infinite;
  }

  .orbit-ring-2 {
    animation: ring-rotate-reverse 35s linear infinite;
  }

  /* Photo glow pulse */
  .photo-glow {
    box-shadow: 0 0 40px rgba(96, 165, 250, 0.15), 0 0 80px rgba(96, 165, 250, 0.05);
  }

  /* Light mode adjustments */
  :global(html.light) .floating-logo {
    background: rgba(255, 255, 255, 0.9);
    border-color: rgba(30, 58, 95, 0.15);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1), 0 0 20px rgba(37, 99, 235, 0.1);
  }

  :global(html.light) .floating-logo:hover {
    box-shadow: 0 4px 20px rgba(37, 99, 235, 0.3), 0 0 30px rgba(37, 99, 235, 0.15);
  }

  :global(html.light) .orbit-ring,
  :global(html.light) .orbit-ring-2 {
    border-color: rgba(30, 58, 95, 0.1);
  }

  /* Reduce motion for accessibility */
  @media (prefers-reduced-motion: reduce) {
    .floating-logo,
    .orbit-ring,
    .orbit-ring-2,
    .animate-pulse-slow {
      animation: none !important;
    }
  }
</style>
