---
---

<section id="experience" class="py-20 px-6 bg-navy">
  <div class="container mx-auto max-w-6xl">
    
    <!-- Section Header -->
    <div class="text-center mb-12">
      <span class="text-accent text-base font-semibold tracking-widest uppercase">Career Journey</span>
      <h2 class="text-4xl font-bold text-white mt-2">Experience</h2>
      <div class="w-16 h-1 bg-accent mx-auto mt-4 rounded-full"></div>
    </div>

    <!-- 3-Column Grid -->
    <div class="grid md:grid-cols-3 gap-6">

      <!-- Card 1 — NIT Trichy -->
      <div class="exp-card group p-6 rounded-2xl border border-white/15 bg-white/5 backdrop-blur-sm hover:border-white/30 transition-all duration-300 hover:shadow-lg hover:shadow-white/10 flex flex-col">
        <div class="flex items-center justify-between mb-4">
          <span class="px-3 py-1 text-sm font-semibold rounded-full border border-white/30 bg-white/5 text-white">Research</span>
          <span class="text-white/50 text-sm"><i class="fas fa-calendar-alt mr-1"></i>Jun – Aug 2025</span>
        </div>
        <h3 class="text-xl font-bold text-white mb-1">Research Assistant</h3>
        <p class="text-white/70 font-medium text-base mb-3">
          <i class="fas fa-building mr-1 text-accent"></i>NIT, Trichy
        </p>
        <p class="text-white/60 text-base leading-relaxed flex-grow">
          Research internship on Insect Contamination Detection — problem formulation, literature review, data handling, and advanced detection approaches.
        </p>
        <div class="flex flex-wrap gap-2 mt-4 pt-4 border-t border-white/10">
          <span class="px-2 py-1 text-xs rounded-md bg-white/5 text-white/60 border border-white/15">Computer Vision</span>
          <span class="px-2 py-1 text-xs rounded-md bg-white/5 text-white/60 border border-white/15">Deep Learning</span>
          <span class="px-2 py-1 text-xs rounded-md bg-white/5 text-white/60 border border-white/15">Research</span>
        </div>
      </div>

      <!-- Card 2 — Fourth Dimension Advisory -->
      <div class="exp-card group p-6 rounded-2xl border border-white/15 bg-white/5 backdrop-blur-sm hover:border-white/30 transition-all duration-300 hover:shadow-lg hover:shadow-white/10 flex flex-col">
        <div class="flex items-center justify-between mb-4">
          <span class="px-3 py-1 text-sm font-semibold rounded-full border border-white/30 bg-white/5 text-white">Internship</span>
          <span class="text-white/50 text-sm"><i class="fas fa-calendar-alt mr-1"></i>Jan – Feb 2025</span>
        </div>
        <h3 class="text-xl font-bold text-white mb-1">Data Analyst</h3>
        <p class="text-white/70 font-medium text-base mb-3">
          <i class="fas fa-building mr-1 text-accent"></i>Fourth Dimension Advisory, Chennai
        </p>
        <p class="text-white/60 text-base leading-relaxed flex-grow">
          Developed interactive dashboards and converted complex datasets into meaningful visual insights using Power BI, Streamlit, and Python.
        </p>
        <div class="flex flex-wrap gap-2 mt-4 pt-4 border-t border-white/10">
          <span class="px-2 py-1 text-xs rounded-md bg-white/5 text-white/60 border border-white/15">Power BI</span>
          <span class="px-2 py-1 text-xs rounded-md bg-white/5 text-white/60 border border-white/15">Excel</span>
          <span class="px-2 py-1 text-xs rounded-md bg-white/5 text-white/60 border border-white/15">Streamlit</span>
          <span class="px-2 py-1 text-xs rounded-md bg-white/5 text-white/60 border border-white/15">Python</span>
        </div>
      </div>

      <!-- Card 3 — Kyungpook National University -->
      <div class="exp-card group p-6 rounded-2xl border border-white/15 bg-white/5 backdrop-blur-sm hover:border-white/30 transition-all duration-300 hover:shadow-lg hover:shadow-white/10 flex flex-col">
        <div class="flex items-center justify-between mb-4">
          <span class="px-3 py-1 text-sm font-semibold rounded-full border border-white/30 bg-white/5 text-white">Research</span>
          <span class="text-white/50 text-sm"><i class="fas fa-calendar-alt mr-1"></i>Apr – May 2023</span>
        </div>
        <h3 class="text-xl font-bold text-white mb-1">ML Research Intern</h3>
        <p class="text-white/70 font-medium text-base mb-3">
          <i class="fas fa-building mr-1 text-accent"></i>KNU, South Korea <span class="text-white/30">(Remote)</span>
        </p>
        <p class="text-white/60 text-base leading-relaxed flex-grow">
          Focused on AI, ML, and Deep Learning fundamentals. Implemented key ML workflows including data preprocessing, feature engineering, model training, and evaluation.
        </p>
        <div class="flex flex-wrap gap-2 mt-4 pt-4 border-t border-white/10">
          <span class="px-2 py-1 text-xs rounded-md bg-white/5 text-white/60 border border-white/15">Machine Learning</span>
          <span class="px-2 py-1 text-xs rounded-md bg-white/5 text-white/60 border border-white/15">Deep Learning</span>
          <span class="px-2 py-1 text-xs rounded-md bg-white/5 text-white/60 border border-white/15">Python</span>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .exp-card {
    animation: fade-up 0.6s ease-out both;
  }

  .exp-card:nth-child(1) { animation-delay: 0.1s; }
  .exp-card:nth-child(2) { animation-delay: 0.25s; }
  .exp-card:nth-child(3) { animation-delay: 0.4s; }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .exp-card:hover {
    transform: translateY(-4px);
  }

  /* Light mode */
  :global(html.light) .exp-card {
    background: rgba(241, 245, 249, 0.8) !important;
    border-color: rgba(30, 58, 95, 0.1) !important;
  }

  :global(html.light) .exp-card:hover {
    border-color: rgba(37, 99, 235, 0.3) !important;
    box-shadow: 0 10px 25px rgba(37, 99, 235, 0.08) !important;
  }

  :global(html.light) .exp-card h3 {
    color: #0f172a !important;
  }

  :global(html.light) .exp-card p.text-white\/60 {
    color: #475569 !important;
  }
</style>
