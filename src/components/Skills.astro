---
---

<section id="skills" class="py-20 px-6 bg-navy">
  <div class="container mx-auto max-w-6xl">
    
    <!-- Section Header -->
    <div class="text-center mb-14">
      <span class="text-accent text-base font-semibold tracking-widest uppercase">What I Work With</span>
      <h2 class="text-4xl font-bold text-white mt-2">Technical Skills</h2>
      <div class="w-16 h-1 bg-accent mx-auto mt-4 rounded-full"></div>
    </div>

    <!-- Two Column Layout: Languages (left) + AI/ML (right) -->
    <div class="grid md:grid-cols-3 gap-8">

      <!-- Category 1 — Languages (stacked vertically, single column) -->
      <div class="skill-category">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 rounded-lg bg-white/10 border border-white/20 flex items-center justify-center">
            <i class="fas fa-terminal text-accent"></i>
          </div>
          <h3 class="text-xl font-bold text-white">Languages</h3>
        </div>
        <div class="flex flex-col gap-4">
          <!-- Python -->
          <div class="skill-tile group">
            <div class="skill-icon bg-gradient-to-br from-blue-500/20 to-yellow-500/20">
              <i class="fab fa-python text-2xl text-blue-400"></i>
            </div>
            <div>
              <p class="text-white font-semibold text-base">Python</p>
              <p class="text-white/40 text-xs">Primary Language</p>
            </div>
          </div>
          <!-- Java -->
          <div class="skill-tile group">
            <div class="skill-icon bg-gradient-to-br from-red-500/20 to-orange-500/20">
              <i class="fab fa-java text-2xl text-red-400"></i>
            </div>
            <div>
              <p class="text-white font-semibold text-base">Java</p>
              <p class="text-white/40 text-xs">Object-Oriented</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Category 2 — AI / ML (takes 2 columns) -->
      <div class="skill-category md:col-span-2">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 rounded-lg bg-white/10 border border-white/20 flex items-center justify-center">
            <i class="fas fa-brain text-accent"></i>
          </div>
          <h3 class="text-xl font-bold text-white">AI / Machine Learning</h3>
        </div>
        <div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
          <!-- Machine Learning -->
          <div class="skill-tile group">
            <div class="skill-icon bg-gradient-to-br from-accent/20 to-blue-600/20">
              <i class="fas fa-cogs text-2xl text-accent"></i>
            </div>
            <div>
              <p class="text-white font-semibold text-base">Machine Learning</p>
              <p class="text-white/40 text-xs">Supervised & Unsupervised</p>
            </div>
          </div>
          <!-- Data Science -->
          <div class="skill-tile group">
            <div class="skill-icon bg-gradient-to-br from-green-500/20 to-teal-500/20">
              <i class="fas fa-chart-bar text-2xl text-green-400"></i>
            </div>
            <div>
              <p class="text-white font-semibold text-base">Data Science</p>
              <p class="text-white/40 text-xs">Analysis & Visualization</p>
            </div>
          </div>
          <!-- Deep Learning -->
          <div class="skill-tile group">
            <div class="skill-icon bg-gradient-to-br from-purple-500/20 to-pink-500/20">
              <i class="fas fa-project-diagram text-2xl text-purple-400"></i>
            </div>
            <div>
              <p class="text-white font-semibold text-base">Deep Learning</p>
              <p class="text-white/40 text-xs">CNNs, RNNs, Transformers</p>
            </div>
          </div>
          <!-- Computer Vision -->
          <div class="skill-tile group">
            <div class="skill-icon bg-gradient-to-br from-cyan-500/20 to-blue-500/20">
              <i class="fas fa-eye text-2xl text-cyan-400"></i>
            </div>
            <div>
              <p class="text-white font-semibold text-base">Computer Vision</p>
              <p class="text-white/40 text-xs">Detection & Segmentation</p>
            </div>
          </div>
          <!-- NLP -->
          <div class="skill-tile group">
            <div class="skill-icon bg-gradient-to-br from-yellow-500/20 to-amber-500/20">
              <i class="fas fa-language text-2xl text-yellow-400"></i>
            </div>
            <div>
              <p class="text-white font-semibold text-base">NLP</p>
              <p class="text-white/40 text-xs">Text & Language Models</p>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Tools & Frameworks Marquee -->
    <div class="mt-14">
      <p class="text-center text-white/30 text-sm font-medium tracking-wider uppercase mb-6">Tools & Frameworks</p>
      <div class="marquee-container overflow-hidden">
        <div class="marquee-track flex gap-8 items-center">
          <div class="tool-chip"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/tensorflow/tensorflow-original.svg" alt="TensorFlow" class="tool-logo" /><span>TensorFlow</span></div>
          <div class="tool-chip"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/pytorch/pytorch-original.svg" alt="PyTorch" class="tool-logo" /><span>PyTorch</span></div>
          <div class="tool-chip"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/keras/keras-original.svg" alt="Keras" class="tool-logo" /><span>Keras</span></div>
          <div class="tool-chip"><img src="https://upload.wikimedia.org/wikipedia/commons/0/05/Scikit_learn_logo_small.svg" alt="Scikit-learn" class="tool-logo" /><span>Scikit-learn</span></div>
          <div class="tool-chip"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/numpy/numpy-original.svg" alt="NumPy" class="tool-logo" /><span>NumPy</span></div>
          <div class="tool-chip"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/pandas/pandas-original.svg" alt="Pandas" class="tool-logo" /><span>Pandas</span></div>
          <div class="tool-chip"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/opencv/opencv-original.svg" alt="OpenCV" class="tool-logo" /><span>OpenCV</span></div>
          <div class="tool-chip"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/jupyter/jupyter-original.svg" alt="Jupyter" class="tool-logo" /><span>Jupyter</span></div>
          <div class="tool-chip"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/git/git-original.svg" alt="Git" class="tool-logo" /><span>Git</span></div>
          <div class="tool-chip"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/docker/docker-original.svg" alt="Docker" class="tool-logo" /><span>Docker</span></div>
          <!-- Duplicate for infinite scroll -->
          <div class="tool-chip"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/tensorflow/tensorflow-original.svg" alt="TensorFlow" class="tool-logo" /><span>TensorFlow</span></div>
          <div class="tool-chip"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/pytorch/pytorch-original.svg" alt="PyTorch" class="tool-logo" /><span>PyTorch</span></div>
          <div class="tool-chip"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/keras/keras-original.svg" alt="Keras" class="tool-logo" /><span>Keras</span></div>
          <div class="tool-chip"><img src="https://upload.wikimedia.org/wikipedia/commons/0/05/Scikit_learn_logo_small.svg" alt="Scikit-learn" class="tool-logo" /><span>Scikit-learn</span></div>
          <div class="tool-chip"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/numpy/numpy-original.svg" alt="NumPy" class="tool-logo" /><span>NumPy</span></div>
          <div class="tool-chip"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/pandas/pandas-original.svg" alt="Pandas" class="tool-logo" /><span>Pandas</span></div>
          <div class="tool-chip"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/opencv/opencv-original.svg" alt="OpenCV" class="tool-logo" /><span>OpenCV</span></div>
          <div class="tool-chip"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/jupyter/jupyter-original.svg" alt="Jupyter" class="tool-logo" /><span>Jupyter</span></div>
          <div class="tool-chip"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/git/git-original.svg" alt="Git" class="tool-logo" /><span>Git</span></div>
          <div class="tool-chip"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/docker/docker-original.svg" alt="Docker" class="tool-logo" /><span>Docker</span></div>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  /* Skill icon container */
  .skill-icon {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .skill-tile:hover .skill-icon {
    transform: scale(1.15) rotate(5deg);
  }

  /* Skill tiles */
  .skill-tile {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem;
    border-radius: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.03);
    transition: all 0.3s ease;
    cursor: default;
  }

  .skill-tile:hover {
    border-color: rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.08);
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(96, 165, 250, 0.1);
  }

  /* Skill category fade-in */
  .skill-category {
    animation: skill-fade 0.6s ease-out both;
  }

  .skill-category:nth-child(1) { animation-delay: 0.1s; }
  .skill-category:nth-child(2) { animation-delay: 0.3s; }

  @keyframes skill-fade {
    from {
      opacity: 0;
      transform: translateY(15px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Marquee */
  .marquee-container {
    mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
  }

  .marquee-track {
    animation: marquee 30s linear infinite;
    width: max-content;
  }

  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .marquee-track:hover {
    animation-play-state: paused;
  }

  /* Tool chips in marquee */
  .tool-chip {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.03);
    white-space: nowrap;
    flex-shrink: 0;
    transition: all 0.3s ease;
  }

  .tool-chip span {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .tool-chip:hover {
    border-color: rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.08);
  }

  .tool-chip:hover span {
    color: rgba(255, 255, 255, 0.8);
  }

  .tool-logo {
    width: 20px;
    height: 20px;
    object-fit: contain;
    flex-shrink: 0;
  }

  /* Light mode */
  :global(html.light) .skill-tile {
    background: rgba(241, 245, 249, 0.8);
    border-color: rgba(30, 58, 95, 0.1);
  }

  :global(html.light) .skill-tile:hover {
    background: rgba(241, 245, 249, 1);
    border-color: rgba(37, 99, 235, 0.3);
    box-shadow: 0 8px 25px rgba(37, 99, 235, 0.08);
  }

  :global(html.light) .skill-tile p.text-white {
    color: #0f172a;
  }

  :global(html.light) .tool-chip {
    background: rgba(241, 245, 249, 0.8);
    border-color: rgba(30, 58, 95, 0.1);
  }

  :global(html.light) .tool-chip span {
    color: #475569;
  }

  /* Reduce motion */
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none !important;
    }
  }
</style>
