---
const email = "nareshvenkadesh@gmail.com";
const linkedin = "https://www.linkedin.com/in/naresh-v/";
const github = "https://github.com/nareshv-dev";
---

<section id="contact" class="py-24 px-6 bg-navy relative overflow-hidden">
  <!-- Decorative background -->
  <div class="absolute top-0 left-1/4 w-[800px] h-[800px] bg-accent/5 rounded-full blur-[160px] pointer-events-none"></div>
  <div class="absolute bottom-0 right-0 w-[400px] h-[400px] bg-purple-500/5 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="container mx-auto max-w-6xl relative z-10">
    <!-- Two Column Layout -->
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">

      <!-- LEFT — Content -->
      <div class="order-2 lg:order-1">
        <!-- Header -->
        <div class="mb-10">
          <span class="text-accent text-sm font-semibold tracking-widest uppercase">Get In Touch</span>
          <h2 class="text-4xl md:text-5xl font-bold text-white mt-3 leading-tight">Let's Work Together</h2>
          <div class="w-16 h-1 bg-accent mt-5 rounded-full"></div>
          <p class="text-white/50 mt-5 max-w-md text-lg leading-relaxed">
            Have a project in mind, a research idea, or just want to say hello? I'd love to hear from you.
          </p>
        </div>

        <!-- Email -->
        <div class="flex items-center gap-4 mb-6 p-4 rounded-xl border border-white/10 bg-white/[0.03] backdrop-blur-sm">
          <div class="w-12 h-12 rounded-xl bg-accent/10 border border-accent/30 flex items-center justify-center flex-shrink-0">
            <i class="fas fa-envelope text-lg text-accent"></i>
          </div>
          <div>
            <p class="text-white/40 text-xs uppercase tracking-widest mb-0.5">Email</p>
            <a href={`mailto:${email}`} class="text-white font-semibold hover:text-accent transition-colors duration-300 text-sm md:text-base break-all">
              {email}
            </a>
          </div>
        </div>

        <!-- Send Message Button -->
        <a
          href="https://mail.google.com/mail/?view=cm&to=nareshvenkadesh@gmail.com&su=Hello%20Naresh"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 px-8 py-4 bg-gradient-to-r from-accent to-purple-500 text-white font-bold text-base rounded-xl hover:shadow-lg hover:shadow-accent/25 transition-all duration-300 hover:-translate-y-1 group mb-8"
        >
          <i class="fas fa-paper-plane group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform duration-300"></i>
          Send Me a Message
        </a>

        <!-- Divider -->
        <div class="flex items-center gap-4 mb-6">
          <div class="flex-1 h-px bg-white/10"></div>
          <span class="text-white/30 text-xs uppercase tracking-widest">or connect on</span>
          <div class="flex-1 h-px bg-white/10"></div>
        </div>

        <!-- Social Links -->
        <div class="flex gap-4">
          <a href={linkedin} target="_blank" rel="noopener noreferrer"
            class="group flex items-center gap-3 px-5 py-3 rounded-xl border border-white/10 bg-white/[0.03] hover:border-blue-400/40 hover:bg-blue-400/10 transition-all duration-300">
            <i class="fab fa-linkedin-in text-lg text-blue-400 group-hover:scale-110 transition-transform"></i>
            <span class="text-white/70 group-hover:text-white font-medium text-sm">LinkedIn</span>
          </a>
          <a href={github} target="_blank" rel="noopener noreferrer"
            class="group flex items-center gap-3 px-5 py-3 rounded-xl border border-white/10 bg-white/[0.03] hover:border-white/40 hover:bg-white/10 transition-all duration-300">
            <i class="fab fa-github text-lg text-white/80 group-hover:scale-110 transition-transform"></i>
            <span class="text-white/70 group-hover:text-white font-medium text-sm">GitHub</span>
          </a>
        </div>
      </div>

      <!-- RIGHT — Animated Conversation Illustration -->
      <div class="order-1 lg:order-2 flex items-center justify-center">
        <div class="conversation-scene relative w-full max-w-md aspect-square">

          <!-- Glowing backdrop circle -->
          <div class="absolute inset-8 rounded-full bg-gradient-to-br from-accent/10 via-purple-500/10 to-blue-500/10 blur-2xl animate-pulse-slow"></div>

          <!-- Central circle with people icons -->
          <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-32 h-32 rounded-full bg-white/[0.06] border border-white/15 flex items-center justify-center backdrop-blur-sm z-10">
            <div class="flex items-end gap-2">
              <!-- Person 1 -->
              <div class="person-1 flex flex-col items-center">
                <div class="w-8 h-8 rounded-full bg-gradient-to-br from-accent to-blue-400 flex items-center justify-center">
                  <i class="fas fa-user text-xs text-white"></i>
                </div>
                <div class="w-6 h-4 rounded-t-full bg-gradient-to-br from-accent to-blue-400 mt-0.5 opacity-60"></div>
              </div>
              <!-- Person 2 -->
              <div class="person-2 flex flex-col items-center">
                <div class="w-8 h-8 rounded-full bg-gradient-to-br from-purple-400 to-pink-400 flex items-center justify-center">
                  <i class="fas fa-user text-xs text-white"></i>
                </div>
                <div class="w-6 h-4 rounded-t-full bg-gradient-to-br from-purple-400 to-pink-400 mt-0.5 opacity-60"></div>
              </div>
            </div>
          </div>

          <!-- Chat Bubble 1 — Top Left -->
          <div class="chat-bubble chat-bubble-1 absolute top-[10%] left-[5%] bg-gradient-to-br from-accent/20 to-accent/10 border border-accent/30 rounded-2xl rounded-bl-sm px-4 py-3 backdrop-blur-sm max-w-[160px]">
            <div class="flex gap-1.5 mb-1.5">
              <div class="w-1.5 h-1.5 rounded-full bg-accent animate-typing-dot-1"></div>
              <div class="w-1.5 h-1.5 rounded-full bg-accent animate-typing-dot-2"></div>
              <div class="w-1.5 h-1.5 rounded-full bg-accent animate-typing-dot-3"></div>
            </div>
            <p class="text-white/70 text-xs leading-relaxed">Hey, let's build something amazing!</p>
          </div>

          <!-- Chat Bubble 2 — Top Right -->
          <div class="chat-bubble chat-bubble-2 absolute top-[8%] right-[5%] bg-gradient-to-br from-purple-500/20 to-purple-500/10 border border-purple-400/30 rounded-2xl rounded-br-sm px-4 py-3 backdrop-blur-sm max-w-[150px]">
            <p class="text-white/70 text-xs leading-relaxed">I have a great idea for AI!</p>
            <div class="flex justify-end gap-0.5 mt-1">
              <i class="fas fa-check text-[8px] text-purple-400"></i>
              <i class="fas fa-check text-[8px] text-purple-400"></i>
            </div>
          </div>

          <!-- Chat Bubble 3 — Bottom Left -->
          <div class="chat-bubble chat-bubble-3 absolute bottom-[15%] left-[2%] bg-gradient-to-br from-blue-500/20 to-blue-500/10 border border-blue-400/30 rounded-2xl rounded-bl-sm px-4 py-3 backdrop-blur-sm max-w-[140px]">
            <p class="text-white/70 text-xs leading-relaxed">Let's collaborate! 🚀</p>
          </div>

          <!-- Chat Bubble 4 — Bottom Right -->
          <div class="chat-bubble chat-bubble-4 absolute bottom-[12%] right-[3%] bg-gradient-to-br from-emerald-500/20 to-emerald-500/10 border border-emerald-400/30 rounded-2xl rounded-br-sm px-4 py-3 backdrop-blur-sm max-w-[150px]">
            <p class="text-white/70 text-xs leading-relaxed">Sounds exciting, I'm in!</p>
            <div class="flex justify-end gap-0.5 mt-1">
              <i class="fas fa-heart text-[8px] text-red-400"></i>
            </div>
          </div>

          <!-- Floating icons orbiting -->
          <div class="orbit-ring absolute inset-4 rounded-full border border-white/5">
            <!-- Email icon -->
            <div class="floating-icon icon-1 absolute w-10 h-10 rounded-xl bg-white/[0.06] border border-white/15 flex items-center justify-center backdrop-blur-sm">
              <i class="fas fa-envelope text-sm text-accent"></i>
            </div>
            <!-- Code icon -->
            <div class="floating-icon icon-2 absolute w-10 h-10 rounded-xl bg-white/[0.06] border border-white/15 flex items-center justify-center backdrop-blur-sm">
              <i class="fas fa-code text-sm text-purple-400"></i>
            </div>
            <!-- Lightbulb icon -->
            <div class="floating-icon icon-3 absolute w-10 h-10 rounded-xl bg-white/[0.06] border border-white/15 flex items-center justify-center backdrop-blur-sm">
              <i class="fas fa-lightbulb text-sm text-yellow-400"></i>
            </div>
            <!-- Handshake icon -->
            <div class="floating-icon icon-4 absolute w-10 h-10 rounded-xl bg-white/[0.06] border border-white/15 flex items-center justify-center backdrop-blur-sm">
              <i class="fas fa-handshake text-sm text-emerald-400"></i>
            </div>
          </div>

          <!-- Connecting lines (decorative) -->
          <svg class="absolute inset-0 w-full h-full z-0 opacity-20" viewBox="0 0 400 400">
            <line x1="200" y1="200" x2="60" y2="80" stroke="url(#lineGrad1)" stroke-width="1" class="animate-line-draw-1"/>
            <line x1="200" y1="200" x2="340" y2="70" stroke="url(#lineGrad2)" stroke-width="1" class="animate-line-draw-2"/>
            <line x1="200" y1="200" x2="50" y2="310" stroke="url(#lineGrad3)" stroke-width="1" class="animate-line-draw-3"/>
            <line x1="200" y1="200" x2="350" y2="320" stroke="url(#lineGrad4)" stroke-width="1" class="animate-line-draw-4"/>
            <defs>
              <linearGradient id="lineGrad1"><stop offset="0%" stop-color="rgb(var(--accent-rgb, 99 102 241))" /><stop offset="100%" stop-color="transparent" /></linearGradient>
              <linearGradient id="lineGrad2"><stop offset="0%" stop-color="#a855f7" /><stop offset="100%" stop-color="transparent" /></linearGradient>
              <linearGradient id="lineGrad3"><stop offset="0%" stop-color="#3b82f6" /><stop offset="100%" stop-color="transparent" /></linearGradient>
              <linearGradient id="lineGrad4"><stop offset="0%" stop-color="#10b981" /><stop offset="100%" stop-color="transparent" /></linearGradient>
            </defs>
          </svg>

          <!-- Particle dots -->
          <div class="particle particle-1 absolute w-1.5 h-1.5 rounded-full bg-accent/60"></div>
          <div class="particle particle-2 absolute w-1 h-1 rounded-full bg-purple-400/60"></div>
          <div class="particle particle-3 absolute w-1.5 h-1.5 rounded-full bg-blue-400/60"></div>
          <div class="particle particle-4 absolute w-1 h-1 rounded-full bg-emerald-400/60"></div>
          <div class="particle particle-5 absolute w-2 h-2 rounded-full bg-yellow-400/40"></div>
          <div class="particle particle-6 absolute w-1 h-1 rounded-full bg-pink-400/60"></div>
        </div>
      </div>

    </div>

    <!-- Footer note -->
    <p class="text-center text-white/25 text-sm mt-16">
      © 2026 Naresh Venkadesh. Built with passion and purpose.
    </p>
  </div>
</section>

<style>
  /* Pulse slow for background glow */
  @keyframes pulse-slow {
    0%, 100% { opacity: 0.5; transform: scale(1); }
    50% { opacity: 0.8; transform: scale(1.05); }
  }
  .animate-pulse-slow { animation: pulse-slow 4s ease-in-out infinite; }

  /* Chat bubbles float in with staggered timing */
  @keyframes bubble-float-in {
    0% { opacity: 0; transform: translateY(20px) scale(0.8); }
    50% { opacity: 1; transform: translateY(-5px) scale(1.02); }
    100% { opacity: 1; transform: translateY(0) scale(1); }
  }
  @keyframes bubble-hover {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  .chat-bubble {
    animation: bubble-float-in 0.8s ease-out both, bubble-hover 4s ease-in-out infinite;
  }
  .chat-bubble-1 { animation-delay: 0.2s, 1s; }
  .chat-bubble-2 { animation-delay: 0.6s, 1.5s; }
  .chat-bubble-3 { animation-delay: 1s, 2s; }
  .chat-bubble-4 { animation-delay: 1.4s, 2.5s; }

  /* Typing dots */
  @keyframes typing-bounce {
    0%, 60%, 100% { opacity: 0.3; transform: translateY(0); }
    30% { opacity: 1; transform: translateY(-4px); }
  }
  .animate-typing-dot-1 { animation: typing-bounce 1.4s ease-in-out infinite; }
  .animate-typing-dot-2 { animation: typing-bounce 1.4s ease-in-out infinite 0.2s; }
  .animate-typing-dot-3 { animation: typing-bounce 1.4s ease-in-out infinite 0.4s; }

  /* Floating icons positioned around the orbit */
  .icon-1 { top: 0%; left: 50%; transform: translate(-50%, -50%); animation: float-icon 5s ease-in-out infinite; }
  .icon-2 { top: 50%; right: 0%; transform: translate(50%, -50%); animation: float-icon 5s ease-in-out infinite 1.2s; }
  .icon-3 { bottom: 0%; left: 50%; transform: translate(-50%, 50%); animation: float-icon 5s ease-in-out infinite 2.4s; }
  .icon-4 { top: 50%; left: 0%; transform: translate(-50%, -50%); animation: float-icon 5s ease-in-out infinite 3.6s; }

  @keyframes float-icon {
    0%, 100% { opacity: 0.6; filter: brightness(1); }
    50% { opacity: 1; filter: brightness(1.3); }
  }

  /* SVG line draw animation */
  @keyframes line-draw {
    0% { stroke-dashoffset: 300; opacity: 0; }
    50% { opacity: 0.6; }
    100% { stroke-dashoffset: 0; opacity: 0.3; }
  }
  .animate-line-draw-1 { stroke-dasharray: 300; animation: line-draw 2s ease-out 0.5s both; }
  .animate-line-draw-2 { stroke-dasharray: 300; animation: line-draw 2s ease-out 0.8s both; }
  .animate-line-draw-3 { stroke-dasharray: 300; animation: line-draw 2s ease-out 1.1s both; }
  .animate-line-draw-4 { stroke-dasharray: 300; animation: line-draw 2s ease-out 1.4s both; }

  /* Floating particles */
  @keyframes particle-drift-1 {
    0% { top: 20%; left: 30%; opacity: 0; }
    25% { opacity: 0.8; }
    50% { top: 15%; left: 35%; opacity: 0.4; }
    75% { opacity: 0.8; }
    100% { top: 20%; left: 30%; opacity: 0; }
  }
  @keyframes particle-drift-2 {
    0% { top: 70%; right: 25%; opacity: 0; }
    25% { opacity: 0.6; }
    50% { top: 65%; right: 20%; opacity: 0.3; }
    75% { opacity: 0.7; }
    100% { top: 70%; right: 25%; opacity: 0; }
  }
  @keyframes particle-drift-3 {
    0% { top: 40%; left: 15%; opacity: 0; }
    50% { top: 35%; left: 10%; opacity: 0.7; }
    100% { top: 40%; left: 15%; opacity: 0; }
  }
  @keyframes particle-drift-4 {
    0% { bottom: 25%; right: 15%; opacity: 0; }
    50% { bottom: 30%; right: 12%; opacity: 0.6; }
    100% { bottom: 25%; right: 15%; opacity: 0; }
  }
  @keyframes particle-drift-5 {
    0% { top: 55%; left: 70%; opacity: 0; }
    50% { top: 50%; left: 75%; opacity: 0.5; }
    100% { top: 55%; left: 70%; opacity: 0; }
  }
  @keyframes particle-drift-6 {
    0% { top: 30%; right: 40%; opacity: 0; }
    50% { top: 25%; right: 35%; opacity: 0.6; }
    100% { top: 30%; right: 40%; opacity: 0; }
  }

  .particle-1 { animation: particle-drift-1 6s ease-in-out infinite; }
  .particle-2 { animation: particle-drift-2 7s ease-in-out infinite 1s; }
  .particle-3 { animation: particle-drift-3 5s ease-in-out infinite 2s; }
  .particle-4 { animation: particle-drift-4 8s ease-in-out infinite 0.5s; }
  .particle-5 { animation: particle-drift-5 6s ease-in-out infinite 3s; }
  .particle-6 { animation: particle-drift-6 7s ease-in-out infinite 1.5s; }

  /* People subtle bounce */
  .person-1 { animation: person-bounce 3s ease-in-out infinite; }
  .person-2 { animation: person-bounce 3s ease-in-out infinite 0.5s; }
  @keyframes person-bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-3px); }
  }
</style>
